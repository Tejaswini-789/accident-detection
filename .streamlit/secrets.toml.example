# Accident Detection System - Streamlit Cloud Secrets Template
# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to GitHub

[email]
ALERT_EMAIL_SENDER   = "your_gmail@gmail.com"
ALERT_EMAIL_PASSWORD = "your_app_password_here"
ALERT_EMAIL_RECEIVER = "emergency@example.com"
